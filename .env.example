# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend-only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Monitoring & Logging
SENTRY_DSN=your-sentry-dsn-here

# Optional: Email
# Resend bypasses Supabase's built-in email rate limits for signup confirmation
# emails. See https://resend.com for a free key (100 emails/day).
#
# IMPORTANT (free plan): with the default `onboarding@resend.dev` from address,
# Resend only delivers to YOUR OWN email address. To send confirmation emails to
# customers, verify a domain at https://resend.com/domains and set
# RESEND_FROM_EMAIL to an address on that domain, e.g. "Waiter AI <no-reply@your-domain.com>".
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Waiter AI <onboarding@resend.dev>

# E2E Tests (Playwright) — only needed to run auth-requiring E2E tests
# (orders workspace + platform setup). Without these, those tests are skipped.
E2E_SUPER_ADMIN_EMAIL=your-super-admin-email-here
E2E_SUPER_ADMIN_PASSWORD=your-super-admin-password-here
