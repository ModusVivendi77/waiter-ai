# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend-only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Monitoring & Logging
SENTRY_DSN=your-sentry-dsn-here

# Optional: Email
# Resend is recommended: it bypasses Supabase's built-in email rate limits for
# signup confirmation emails. When unset, the app falls back to Supabase's
# "Confirm signup" template (rate-limited, ~1 per minute per email).
# Get a free key at https://resend.com (100 emails/day on the free plan).
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Waiter AI <onboarding@resend.dev>

# E2E Tests (Playwright) — only needed to run auth-requiring E2E tests
# (orders workspace + platform setup). Without these, those tests are skipped.
E2E_SUPER_ADMIN_EMAIL=your-super-admin-email-here
E2E_SUPER_ADMIN_PASSWORD=your-super-admin-password-here
